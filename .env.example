# ----------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR Y EMAIL REAL (SMTP)
# ----------------------------------------------------
PORT=3001

# Servidor SMTP para envío de correos reales a clientes
# Ejemplos de configuración:
#
# Opción 1: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# EMAIL_FROM="Maison Coquette" <tu_correo@gmail.com>
#
# Opción 2: Brevo / Sendinblue (Gratuito 300 emails/día)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_usuario_brevo
# SMTP_PASS=tu_api_key_brevo
# EMAIL_FROM="Maison Coquette" <hola@tudominio.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Maison Coquette Studio" <no-reply@maisoncoquette.com>
